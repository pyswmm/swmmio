 IF NODE SU1 DEPTH >= 4
 THEN PUMP PUMP1 status = ON
 PRIORITY 1 
RULE PUMP1B   
 IF NODE SU1 DEPTH < 1
 THEN PUMP PUMP1 status = OFF
 PRIORITY 1 

